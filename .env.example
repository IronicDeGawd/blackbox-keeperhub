# Blackbox configuration.
#
# Copy to .env.local for development, or to .env on the deployment host, and
# fill in what you need. Almost everything here is optional: a capability whose
# configuration is missing does not half-work, it stops existing, and
# GET /api/config reports which controls this process can actually drive.
#
# Required, and the process refuses to start without one of them:
#   SEPOLIA_RPC_URL or ALCHEMY_RPC_URL
#
# Required in a deployed container, where the local development database
# cannot exist:
#   DATABASE_URL

# --- chain access ------------------------------------------------------------

# At least one is required. Any public endpoint works; no key is needed.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Preferred when set, since a keyed endpoint is not rate limited into
# uselessness. The key is part of the URL, so treat the whole value as a secret.
ALCHEMY_RPC_URL=

# A third endpoint consulted only when looking up a transaction someone else's
# wallet broadcast. Queued transactions — those sitting above an unused nonce —
# are never gossiped between nodes, so a transaction can exist on exactly one
# endpoint and nowhere else. More endpoints, better odds of finding it.
FALLBACK_RPC_URL=

CHAIN_ID=11155111

# --- storage -----------------------------------------------------------------

# Development falls back to the docker-compose database on port 5433. In a
# container the process refuses to start rather than silently connect to a host
# that cannot exist there.
DATABASE_URL=postgres://blackbox:blackbox@localhost:5433/blackbox

# Only read by compose.deploy.yml, to build the URL above for the deployment.
POSTGRES_PASSWORD=

# --- KeeperHub ---------------------------------------------------------------

# Without it, incidents are still detected and explained; remediation through
# KeeperHub workflows and direct execution is simply absent.
KEEPERHUB_ORG_KEY=

# --- diagnosis ---------------------------------------------------------------

# Vertex authenticates through Application Default Credentials, so there is no
# API key: on a Compute Engine VM or Cloud Run the attached service account is
# used automatically, and locally `gcloud auth application-default login` is
# enough. The service account needs roles/aiplatform.user.
# Without this, incidents are detected but never explained.
GOOGLE_CLOUD_PROJECT=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- chaos -------------------------------------------------------------------

# The deployed ChaosTarget and CircuitBreaker. Needed for the contract-level
# scenarios (C3, C4) whether Blackbox signs them or a visitor signs them
# themselves; the wallet-signed plans decline without a target to call.
CHAOS_TARGET_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=

# A funded testnet key, which turns on server-signed chaos and server-signed
# remediation.
#
# Leave this EMPTY on any public deployment. The API is unauthenticated by
# design, so a key here is a spendable key handed to the open internet. Without
# it, visitors sign their own chaos and their own remediations from their own
# wallets, which is the intended public behaviour and costs us nothing.
CHAOS_SIGNER_PRIVATE_KEY=

# --- behaviour ---------------------------------------------------------------

# Live remediation is opt-in even where a key exists. Anything but "false"
# keeps it a rehearsal.
BLACKBOX_DRY_RUN=true

# How often the detection loop polls. Detection latency is made of this.
BLACKBOX_TICK_MS=15000

# --- deployment --------------------------------------------------------------

# The hostname Caddy obtains a certificate for. sslip.io resolves any name of
# the form 1-2-3-4.sslip.io to that IP, so the VM gets a real HTTPS name with
# no domain purchase.
BLACKBOX_HOST=

# Encrypts an operator's KeeperHub refresh token at rest. 64 hex characters, or
# any passphrase. Generate with: openssl rand -hex 32
# Unset means connecting a KeeperHub account is refused rather than stored in
# the clear; signing in still works.
BLACKBOX_ENCRYPTION_KEY=
